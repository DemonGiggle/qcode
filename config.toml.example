# Default provider (built-in kind or named [providers.<name>] instance).
provider = "ollama"

# Terminal theme ("default" keeps terminal ANSI colors; /theme previews live).
# See docs/configuration.md for theme IDs.
# theme = "catppuccin-mocha"

# Maximum model turns per request.
max_steps = 32

# Maximum wait for a batch of agent consultations (e.g. "90s", "5m").
# agent_timeout = "5m"

# Automatic code review after main finishes (/autoreview on|off).
# autoreview = true
# autoreview_provider = "ollama"
# autoreview_model = "qwen2.5-coder:7b"

# Isolate model-triggered tools with bubblewrap on Linux (off by default).
# Disables web tools and networking initially; /tool toggles web tools.
# sandbox = true

# Trusted read-only executable directories prepended to sandbox PATH.
# Keep only paths that exist on your machine.
# sandbox_command_paths = [
#   "~/.local/bin", "~/bin", "~/go/bin", "~/.cargo/bin",
#   "~/.npm-global/bin", "~/.local/share/pnpm", "~/.bun/bin", "~/.deno/bin",
# ]

# ChatGPT OAuth token file written by `qcode login chatgpt` (0600, no symlink).
# [chatgpt]
# oauth_path = "~/.config/qcode/chatgpt-oauth.json"

# Skip TLS certificate verification for HTTP clients (insecure).
# danger_skip_tls_verify = true

# Context capacity in tokens for terminal agents (0 = automatic).
# context_window = 32768

# Auto-compact percentage (1-99, default 80) or disable completely.
# auto_compact_threshold = 80
# disable_auto_compact = true

# Allow up to 3 focused questions per prompt in interactive terminals.
# interactive = true

# Status bar segments to hide: remote, mode, model, think, ws, ctx, step, tok.
# /statusline toggles and saves to the user config.
# statusline_hidden = ["tok"]

# Web search backend (only "duckduckgo" is supported; requires restart).
[web_search]
backend = "duckduckgo"

# Max approximate tokens of global learning per request (0 disables retrieval).
[learning]
context_budget = 1200

# Additional skill directories (<name>/SKILL.md); see docs/configuration.md.
# [skills]
# paths = ["~/.config/my-skills", ".team/skills"]
# autoload_paths = [".team/always-on-skills"]
# [[skills.autoload]]
# path = ".team/always-on-skills"
# always_load = true
# selected = ["review-go"]
# selected_always = []

# Sub-agent model roster (/agent allow-models; roles: smart|balanced|cheap).
# Empty roster lets helpers use main's current provider/model.
# [[agents.allow_models]]
# provider = "openai"
# model = "gpt-5"
# role = "smart"
# [[agents.allow_models]]
# provider = "openai"
# model = "gpt-5-mini"
# role = "balanced"
# [[agents.allow_models]]
# provider = "ollama"
# model = "qwen2.5-coder:7b"
# role = "cheap"

# Local output redaction (enabled at every output boundary by default; see docs/privacy.md).
[redaction]
terminal = true
persistence = true
exports = true
json_events = true
remote = true
custom_patterns = []   # Go/RE2 regexes (one per logical line)
sensitive_paths = []   # Literal paths to mask
sensitive_fields = []  # Extra credential field names

# Provider profiles (keep [providers.<name>] AFTER all root-level settings).
# API key precedence: --api-key > QCODE_API_KEY > provider env key > api_key_path.
# Use 0600/0400 key files (one line, no quotes). Unconfigured providers show
# `(Need Setup First)` in the UI; broken key files fail `qcode config check`.

[providers.ollama]
base_url = "http://127.0.0.1:11434"
model = "qwen2.5-coder:7b"

[providers.openai]
# api_key_path = "~/.config/qcode/openai.key"
# model = "my-model"
# thinking = "high"

[providers.opencode-go]
# api_key_path = "~/.config/qcode/opencode-go.key"
# base_url = "https://your-endpoint.example/v1"

[providers.gemini]
# api_key_path = "~/.config/qcode/gemini.key"
# model = "gemini-3-flash-preview"
# thinking = "high" # see docs/providers.md for model-specific choices
# base_url = "https://generativelanguage.googleapis.com/v1beta"

[providers.chatgpt]
# Uses OAuth (`qcode login chatgpt`), not api_key/api_key_path.
# model = "gpt-5.6-codex"

# Named provider instances (select with --provider or /provider; see docs/configuration.md).
# [providers.ollama-lab]
# type = "ollama"
# base_url = "http://192.168.1.50:11434"
# model = "qwen2.5-coder:32b"
# thinking = ""
#
# [providers.openai-work]
# type = "openai"
# base_url = "https://inference.example.com/v1"
# api_key_path = "~/.config/qcode/work.key"
# model = "work-coder"
