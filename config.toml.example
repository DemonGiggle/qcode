# Default provider selected at startup: ollama, openai, gemini, opencode-go, or chatgpt.
# Root keeps only the global default; connection settings live under
# [providers.<name>] below.
provider = "ollama"

# Terminal palette. Omit this field or choose "default" to keep the terminal's
# current ANSI colors and background. /theme opens a live-preview picker.
# See docs/configuration.md for all dark and light theme IDs.
# theme = "catppuccin-mocha"

# Maximum number of model turns allowed for each request.
max_steps = 32

# Maximum wait for a batch of agent consultations, including queue time.
# Positive duration (e.g. "90s", "5m", "15m"); default is five minutes.
# agent_timeout = "5m"

# Isolate model-triggered tools with bubblewrap on Linux. Disabled by default.
# Fresh sandbox sessions disable both web tools and block networking.
# Enabling either web tool through /tool allows web and shell networking;
# disabling both blocks it again. /new restores these sandbox defaults.
# sandbox = true

# Persistent trusted executable directories for sandbox mode. Each existing
# directory is mounted read-only at its original path and prepended to the
# sandbox PATH, while the rest of home stays hidden. Session
# request_directory_access grants remain separate, read/write, and temporary.
# Common user-installed tool directories; keep only paths that exist for you.
# sandbox_command_paths = [
#   "~/.local/bin", "~/bin", "~/go/bin", "~/.cargo/bin",
#   "~/.npm-global/bin", "~/.local/share/pnpm", "~/.bun/bin", "~/.deno/bin",
# ]
# With nvm, also add the active Node/npm version's bin directory, for example
# "~/.nvm/versions/node/v22.16.0/bin" (replace with your installed version).

# Connections are scoped to providers, independently of the default selection.
# Omitted profile fields inherit from lower-priority config files; an explicit
# empty string clears a lower-priority value. Relative api_key_path entries
# resolve from the config file that declares them. Place active profile tables
# AFTER all root-level settings (at end of file).
# [providers.ollama]
# base_url = "http://127.0.0.1:11434"
# model = "qwen2.5-coder:7b"
# [providers.openai]
# api_key_path = "~/.config/qcode/openai.key"
# model = "my-model"
# thinking = "high"
# [providers.opencode-go]
# base_url = "https://your-endpoint.example/v1"
# api_key_path = "~/.config/qcode/opencode-go.key"
# [providers.gemini]
# api_key_path = "~/.config/qcode/gemini.key"
# model = "gemini-3-flash-preview"
# thinking = "high" # choices depend on the exact model; see docs/providers.md
# Google OpenAI-compatible endpoint is the default; override only if needed.
# base_url = "https://generativelanguage.googleapis.com/v1beta/openai/"
# The chatgpt provider uses OAuth; providers.chatgpt.api_key/api_key_path are invalid.
# Run `qcode login chatgpt` first, then select provider = "chatgpt".

# API keys: prefer api_key_path files (0600 or 0400, owner-only, no symlink,
# one line, no quotes) or QCODE_API_KEY / OPENAI_API_KEY /
# GEMINI_API_KEY / GOOGLE_API_KEY / --api-key.
# At startup: --api-key > QCODE_API_KEY > provider-specific environment key
# (OPENAI_API_KEY for OpenAI; GEMINI_API_KEY then GOOGLE_API_KEY for Gemini)
# > api_key_path file > providers.<name>.api_key (deprecated).
# A profile with both api_key and api_key_path fails to load; keep one source.
# Broken key files warn at startup (the provider shows Need Setup First) and
# fail `qcode config check`. Run `qcode config check` for fix suggestions.

# ChatGPT subscription (no API key). Run `qcode login chatgpt` first,
# then use --provider chatgpt --model gpt-5.6-codex.
# ChatGPT OAuth file written by `qcode login chatgpt`. Empty uses the
# default ~/.config/qcode/chatgpt-oauth.json (0600, owner-only, no symlink).
# [chatgpt]
# oauth_path = "~/.config/qcode/chatgpt-oauth.json"

# Skip TLS certificate verification for qcode HTTP clients (insecure). Shell
# commands receive opt-out settings for common clients but may need their own flags.
# danger_skip_tls_verify = true

# Context capacity in tokens for terminal agents (0 = automatic).
# Set this for custom endpoints or models missing from the bundled catalog.
# Used for the status bar and automatic compaction; the server's actual
# context allocation is unchanged.
# context_window = 32768

# Compact the conversation automatically after this percentage of a known
# context window is used (1-99, default 80). Manual /compact remains available.
# auto_compact_threshold = 80
# disable_auto_compact = true

# Allow the agent to ask up to three focused questions per prompt in an
# interactive terminal. One-shot and JSON event runs never block for answers.
# interactive = true

# Status bar segments to hide. Valid names: remote, mode, model, think, ws,
# ctx, step, tok (model controls the combined provider prefix and MODEL unit).
# Narrow terminals shorten the workspace, then wrap to two status rows before
# dropping segments in the order tok, step, ctx, ws, think, model, mode, remote.
# Use /statusline to toggle without editing this file; changes on main save
# to the user-level config file.
# statusline_hidden = ["tok"]

# Web tools start enabled outside sandbox mode, including in one-shot runs.
# In sandbox mode both start disabled; /tool can change their selections.
# Web search backend, read at startup. Currently only duckduckgo is supported.
# Omitting this section defaults to duckduckgo. Changes require a restart.
# This backend setting does not change tool enablement.
[web_search]
backend = "duckduckgo"

# Maximum approximate tokens of relevant global learning per model request.
# Up to three items are retrieved. Set 0 to disable retrieval; /learn still works.
[learning]
context_budget = 1200

# Optional additional skill directories. Paths may be absolute or relative to
# the selected workspace; a directory contains <name>/SKILL.md.
# [skills]
# paths = ["~/.config/my-skills", ".team/skills"]
# Legacy lazy autoload: every valid skill in these directories is selected
# at startup but stays lazy (catalog only).
# autoload_paths = [".team/always-on-skills"]
# New representation: mark autoload directories as lazy or always-load
# (full text eagerly injected). always_load directories win on duplicate
# skill names for the mode decision.
# [[skills.autoload]]
# path = ".team/always-on-skills"
# always_load = true
# [[skills.autoload]]
# path = ".team/lazy-skills"
# always_load = false
# Persisted explicit selection: /skill on the main tab saves here.
# Selected skills start enabled for new runs and are unioned with autoload;
# selected_always skills are eagerly injected and must also appear in
# selected. Resumed sessions keep their saved selection instead.
# selected = ["review-go"]
# selected_always = []

# Human-curated roster of models main may use for sub-agents.
# Managed by /agent allow-models on the main tab (role only: smart|balanced|cheap).
# Empty roster: helpers use main's current provider/model.
# Nonempty roster: main must choose a listed provider/model pair.
# Providers may be mixed; each uses its configured connection and credentials.
# Main picks thinking_level at creation time from target model capabilities.
# To override a lower-priority roster with an empty list: [agents] allow_models = []
# [[agents.allow_models]]
# provider = "openai"
# model = "gpt-5"
# role = "smart"
# [[agents.allow_models]]
# provider = "openai"
# model = "gpt-5-mini"
# role = "balanced"
# [[agents.allow_models]]
# provider = "ollama"
# model = "qwen2.5-coder:7b"
# role = "cheap"

# Local text filtering is enabled at every output boundary by default.
# Saved sessions are permanently redacted; legacy sessions are rewritten on resume.
# This does not filter provider requests or inspect images. See docs/privacy.md.
[redaction]
terminal = true
persistence = true
exports = true
json_events = true
remote = true
# Each regular expression matches one logical line (Go/RE2 syntax).
custom_patterns = []
# Literal paths; both configured and environment/home-expanded forms are masked.
sensitive_paths = []
# Additional credential field names (case, underscores, spaces and hyphens ignored).
sensitive_fields = []

# Deprecated root connection fields and memory tables. They still run but
# `qcode config check` warns; prefer [providers.<name>] above. Dotted keys
# (providers.openai.api_key) and [providers.openai] tables are equivalent.
# provider = "ollama"          # keep: global default selection (not deprecated)
# model = "qwen2.5-coder:7b"   # deprecated: use [providers.<name>] model
# thinking = "high"            # deprecated: use [providers.<name>] thinking
# base_url = "..."             # deprecated: use [providers.<owner>] base_url
# api_key = "..."              # deprecated: use api_key_path or env
# [provider_models]            # deprecated: use [providers.<name>] model
# opencode-go = "muse-spark-1.3-contributor"
# [provider_thinking]          # deprecated: use [providers.<name>] thinking
# opencode-go = "high"
