[8.323816, "o", "\u001b[?25l\u001b[3;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m> Give me a quick tour of qcode\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                                                         \u001b[0m\u001b[0m\u001b[4;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                                                                                        \u001b[0m\u001b[0m\u001b[5;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m> While that runs, explain the prompt queue\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                                             \u001b[0m\u001b[0m\u001b[6;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                                                                                        \u001b[0m\u001b[0m\u001b[7;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m> Then summarize the async input behavior\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                                               \u001b[0m\u001b[0m\u001b[8;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m\u001b[38;2;98;114;164m• Demo mode: planning a safe, mocked tour of every available tool.\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                      \u001b[0m\u001b[0m\u001b[9;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m\u001b[0m\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m                                                                                                                        \u001b[0m\u001b[0m\u001b[10;1H\u001b[2K\u001b[48;2;40;42;54m\u001b[38;2;248;248;242m\u001b[38;2;139;233;253m↗ Fetc