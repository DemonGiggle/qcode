[21.907231, "o", "\u001b[2D\u001b[K  /agent   Create, list, switch, rename, cancel, or close agents\r\n  /clear   Clear the conversation display\r\n  /compact Compact the active conversation context\r\n  /diff    Expand a recent file diff\r\n  /exit    Exit qcode\r\n  /help    Show available commands\r\n  /learn   Review global learning; list, forget <id>, or compact\r\n  /model   Select a provider model\r\n  /new     Start a session with fresh context\r\n  /resume  Restore a saved session for this workspace\r\n  /skill   Select workspace skills\r\n  /quit    Exit qcode\r\n  /tool    Toggle available tools\r\n  /verbose Toggle detailed action traces\r\n\u001b[36m\u001b[1m> \u001b[0m\u001b[2D\u001b[K\u001b[36m\u001b[1m> \u001b[0m/\u001b[3D\u001b[K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K\u001b[1A\r\u001b[2K  /quit    Exit qcode\r\n\u001b[36m\u001b[1m> \u001b[0m/\u001b[3D\u001b[K\u001b[36m\u001b[1m> \u001b[0m/q\u001b[4D\u001b[K\u001b[1A\r\u001b[2K  /quit    Exit qcode\r\n\u001b[36m\u001b[1m> \u001b[0m/q\u001b[4D\u001b[K\u001b[36m\u001b[1m> \u001b[0m/qu\u001b[5D\u001b[K\u001b[1A\r\u001b[2K  /quit    Exit qcode\r\n\u001b[36m\u001b[1m> \u001b[0m/qu\u001b[5D\u001b[K\u001b[36m\u001b[1m> \u001b[0m/qui\u001b[6D\u001b[K\u001b[1A\r\u001b[2K  /quit    Exit qcode\r\n\u001b[36m\u001b[1m> \u001b[0m/qui\u001b[6D\u001b[K\u001b[36m\u001b[1m> \u001b[0m/quit\r\n\u001b[2A\r\u001b[1M\u001b[1B\r\u001b[s\u001b[1;1H\u001b[2K*[main +] ![agent-1 x]                                                             Switch tabs: Ctrl+PgUp/PgDn | Alt+,/.\u001b[u\r\n\u001b[2mAgent agent-1 cancelled\u001b[0m\r\n\r\n\u001b[r\u001b[35;1H\u001b[J"]
